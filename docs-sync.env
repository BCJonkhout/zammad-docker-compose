ZAMMAD_BASE_URL=https://support.prudai.com
ZAMMAD_DOCS_BASE_URL=https://docs.prudai.com
ZAMMAD_DOCS_KB_NL_ID=1
ZAMMAD_DOCS_KB_EN_ID=2
ZAMMAD_DOCS_SYNC_TOKEN_FILE=/root/zammad/secrets/docs-sync.token

# Optional: Keycloak service-account so the crawl can read SSO-gated docs pages
# (the "competitive edge" pages). Inert unless both client id + secret are set.
# DOCS_KC_ISSUER=https://login.prudai.com/realms/prudai
# DOCS_KC_BOT_CLIENT_ID=prudai-docs-bot
# The secret is read from a file by run-docs-sync.sh (never commit it here):
# ZAMMAD_DOCS_KC_SECRET_FILE=/root/zammad/secrets/docs-bot.secret
